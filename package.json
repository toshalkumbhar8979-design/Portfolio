      "nanoid@^3.0.0": "^3.3.18",
      "picomatch": "^2.3.2",
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^7.1.6",
      "proxy-addr": "^2.0.8",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "undici": "^7.29.1",
      "yaml": "^2.8.3"
    }
  }
}
