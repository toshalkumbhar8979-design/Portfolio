{
  "name": "chronark.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "content:generate": "node scripts/generate-projects.mjs",
    "dev": "node scripts/watch-projects.mjs",
    "build": "pnpm content:generate && next build",
    "cf:build": "pnpm content:generate && opennextjs-cloudflare build",
    "deploy": "pnpm content:generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "pnpm content:generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "fmt": "pnpm rome check . --apply-unsafe && pnpm rome format . --write"
  },
  "dependencies": {
    "@next/mdx": "15.5.27",
    "@upstash/redis": "1.36.4",
    "framer-motion": "10.18.0",
    "lucide-react": "0.284.0",
    "markdown-wasm": "1.2.0",
    "next": "15.5.27",
    "page-mascot": "^0.1.0",
    "pnpm": "^10.34.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-wrap-balancer": "1.1.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.10.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-gfm-v3": "npm:remark-gfm@3.0.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@opentelemetry/api": "1.4.1",
    "@tailwindcss/line-clamp": "0.4.4",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "20.19.37",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.27",
    "postcss": "8.5.29",
    "postcss-nesting": "12.1.5",
    "rome": "12.1.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-debug-screens": "2.2.1",
    "yaml": "2.9.1",
    "wrangler": "4.128.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    },
    "overrides": {
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@^2.0.0": "^2.1.7",
